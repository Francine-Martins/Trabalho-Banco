#include <iostream>
#include <string>
#include <cctype>
#include <limits>

using namespace std;

const int MAX_CONTAS = 100;         
const int MAX_MOVIMENTACOES = 500;   

bool validarCPF(string cpf) {
    string cpfLimpo = "";
    for (char c : cpf) {
        if (isdigit(c)) {
            cpfLimpo += c;
        }
    }

    if (cpfLimpo.length() != 11) return false;

    bool todosIguais = true;
    for (int i = 1; i < 11; i++) {
        if (cpfLimpo[i] != cpfLimpo[0]) {
            todosIguais = false;
            break;
        }
    }
    if (todosIguais) return false;

    int soma = 0;
    for (int i = 0; i < 9; i++) {
        soma += (cpfLimpo[i] - '0') * (10 - i);
    }
    int resto = soma % 11;
    int digito1 = (resto < 2) ? 0 : (11 - resto);

    if (digito1 != (cpfLimpo[9] - '0')) return false;

    soma = 0;
    for (int i = 0; i < 10; i++) {
        soma += (cpfLimpo[i] - '0') * (11 - i);
    }
    resto = soma % 11;
    int digito2 = (resto < 2) ? 0 : (11 - resto);

    if (digito2 != (cpfLimpo[10] - '0')) return false;

    return true;
}

int main() {

    int numeroConta[MAX_CONTAS];
    string nomeCliente[MAX_CONTAS];
    string cpf[MAX_CONTAS];
    int tipoConta[MAX_CONTAS];
    double saldo[MAX_CONTAS];
    bool contaAtiva[MAX_CONTAS];
    int totalCadastradas = 0;

    int contaMovimentacao[MAX_MOVIMENTACOES];
    char tipoMovimentacao[MAX_MOVIMENTACOES];
    double valorMovimentacao[MAX_MOVIMENTACOES];
    int quantidadeMovimentacoes = 0;

    for (int i = 0; i < MAX_CONTAS; i++) {
        contaAtiva[i] = false;
        numeroConta[i] = 0;
        saldo[i] = 0.0;
    }

    int opcao = 0;

    do {
        cout << "\n====================================\n";
        cout << "         BANCO INF101 - ETAPA 2     \n";
        cout << "====================================\n";
        cout << "1 - Cadastrar conta\n";
        cout << "2 - Listar contas cadastradas\n";
        cout << "3 - Consultar conta pelo numero\n";
        cout << "4 - Realizar deposito\n";
        cout << "5 - Realizar saque\n";
        cout << "6 - Realizar transferencia\n";
        cout << "7 - Exibir extrato de uma conta\n";
        cout << "8 - Alterar tipo da conta\n";
        cout << "9 - Ativar/Desativar conta\n";
        cout << "10 - Sair\n";
        cout << "Escolha uma opcao: ";
        cin >> opcao;

        switch (opcao) {
            case 1: { 
                if (totalCadastradas >= MAX_CONTAS) {
                    cout << "\n[ERRO] Limite maximo de " << MAX_CONTAS << " contas atingido!\n";
                    break;
                }

                int idx = totalCadastradas;
                cout << "\n--- CADASTRO DE CONTA (Conta " << (idx + 1) << ") ---\n";

                int num;
                bool numeroExiste;
                do {
                    numeroExiste = false;
                    cout << "Numero da conta (maior que 0): ";
                    cin >> num;
                    if (num <= 0) {
                        cout << "[ERRO] O numero da conta deve ser maior que zero!\n";
                    } else {
                        
                        for (int i = 0; i < totalCadastradas; i++) {
                            if (numeroConta[i] == num) {
                                numeroExiste = true;
                                cout << "[ERRO] Ja existe uma conta com esse numero!\n";
                                break;
                            }
                        }
                    }
                } while (num <= 0 || numeroExiste);
                numeroConta[idx] = num;

                cin.ignore(numeric_limits<streamsize>::max(), '\n');

                cout << "Nome do titular: ";
                getline(cin, nomeCliente[idx]);

                string cpfInput;
                do {
                    cout << "CPF do titular (11 digitos): ";
                    getline(cin, cpfInput);

                    if (!validarCPF(cpfInput)) {
                        cout << "[ERRO] CPF invalido! Digite um CPF valido.\n";
                    }
                } while (!validarCPF(cpfInput));
                cpf[idx] = cpfInput;

                int tipo;
                do {
                    cout << "Tipo de conta (1 - Corrente | 2 - Poupanca): ";
                    cin >> tipo;
                    if (tipo != 1 && tipo != 2) cout << "[ERRO] Tipo invalido! Digite 1 ou 2.\n";
                } while (tipo != 1 && tipo != 2);
                tipoConta[idx] = tipo;

                double s;
                do {
                    cout << "Saldo inicial (nao negativo): R$ ";
                    cin >> s;
                    if (s < 0) cout << "[ERRO] O saldo inicial nao pode ser negativo!\n";
                } while (s < 0);
                saldo[idx] = s;

                contaAtiva[idx] = true;
                totalCadastradas++;

                cout << "\n[SUCESSO] Conta cadastrada com sucesso!\n";
                break;
            }

            case 2: { 
                if (totalCadastradas == 0) {
                    cout << "\n[AVISO] Nenhuma conta cadastrada ate o momento.\n";
                    break;
                }

                cout << "\n--- LISTA DE CONTAS CADASTRADAS ---\n";
                for (int i = 0; i < totalCadastradas; i++) {
                    cout << "------------------------------------\n";
                    cout << "Numero: " << numeroConta[i] << "\n";
                    cout << "Titular: " << nomeCliente[i] << "\n";
                    cout << "CPF: " << cpf[i] << "\n";
                    cout << "Tipo: " << (tipoConta[i] == 1 ? "Corrente" : "Poupanca") << "\n";
                    cout << "Saldo: R$ " << saldo[i] << "\n";
                    cout << "Status: " << (contaAtiva[i] ? "Ativa" : "Inativa") << "\n";
                }
                cout << "------------------------------------\n";
                break;
            }

            case 3: { 
                if (totalCadastradas == 0) {
                    cout << "\n[AVISO] Nenhuma conta cadastrada ate o momento.\n";
                    break;
                }

                int numBusca;
                cout << "\nDigite o numero da conta para consulta: ";
                cin >> numBusca;

                bool encontrada = false;
                for (int i = 0; i < totalCadastradas; i++) {
                    if (numeroConta[i] == numBusca) {
                        encontrada = true;
                        cout << "\n--- DADOS DA CONTA ---\n";
                        cout << "Numero: " << numeroConta[i] << "\n";
                        cout << "Titular: " << nomeCliente[i] << "\n";
                        cout << "CPF: " << cpf[i] << "\n";
                        cout << "Tipo: " << (tipoConta[i] == 1 ? "Corrente" : "Poupanca") << "\n";
                        cout << "Saldo: R$ " << saldo[i] << "\n";
                        cout << "Status: " << (contaAtiva[i] ? "Ativa" : "Inativa") << "\n";
                        break;
                    }
                }
                if (!encontrada) {
                    cout << "\n[ERRO] Conta numero " << numBusca << " nao foi encontrada!\n";
                }
                break;
            }

            case 4: { 
                if (totalCadastradas == 0) {
                    cout << "\n[AVISO] Nenhuma conta cadastrada.\n";
                    break;
                }

                int numBusca;
                cout << "\nDigite o numero da conta para deposito: ";
                cin >> numBusca;

                int idx = -1;
                for (int i = 0; i < totalCadastradas; i++) {
                    if (numeroConta[i] == numBusca) {
                        idx = i;
                        break;
                    }
                }

                if (idx == -1) {
                    cout << "\n[ERRO] Conta nao encontrada!\n";
                } else if (!contaAtiva[idx]) {
                    cout << "\n[AVISO] A conta esta INATIVA. Operacao nao permitida!\n";
                } else {
                    double valor;
                    cout << "Valor do deposito: R$ ";
                    cin >> valor;

                    if (valor <= 0) {
                        cout << "\n[ERRO] O valor do deposito deve ser maior que zero!\n";
                    } else if (quantidadeMovimentacoes >= MAX_MOVIMENTACOES) {
                        cout << "\n[ERRO] Limite de movimentacoes atingido!\n";
                    } else {
                    
                        saldo[idx] = saldo[idx] + valor;
                        contaMovimentacao[quantidadeMovimentacoes] = numeroConta[idx];
                        tipoMovimentacao[quantidadeMovimentacoes] = 'D';
                        valorMovimentacao[quantidadeMovimentacoes] = valor;
                        quantidadeMovimentacoes++;

                        cout << "\n[SUCESSO] Deposito realizado com sucesso!\n";
                    }
                }
                break;
            }

            case 5: { 
                if (totalCadastradas == 0) {
                    cout << "\n[AVISO] Nenhuma conta cadastrada.\n";
                    break;
                }

                int numBusca;
                cout << "\nDigite o numero da conta para saque: ";
                cin >> numBusca;

                int idx = -1;
                for (int i = 0; i < totalCadastradas; i++) {
                    if (numeroConta[i] == numBusca) {
                        idx = i;
                        break;
                    }
                }

                if (idx == -1) {
                    cout << "\n[ERRO] Conta nao encontrada!\n";
                } else if (!contaAtiva[idx]) {
                    cout << "\n[AVISO] A conta esta INATIVA. Operacao nao permitida!\n";
                } else {
                    double valor;
                    cout << "Valor do saque: R$ ";
                    cin >> valor;

                    if (valor <= 0) {
                        cout << "\n[ERRO] O valor do saque deve ser maior que zero!\n";
                    } else if (saldo[idx] < valor) {
                        cout << "\n[ERRO] Saldo insuficiente para realizar o saque!\n";
                    } else if (quantidadeMovimentacoes >= MAX_MOVIMENTACOES) {
                        cout << "\n[ERRO] Limite de movimentacoes atingido!\n";
                    } else {
                    
                        saldo[idx] = saldo[idx] - valor;
                        contaMovimentacao[quantidadeMovimentacoes] = numeroConta[idx];
                        tipoMovimentacao[quantidadeMovimentacoes] = 'S';
                        valorMovimentacao[quantidadeMovimentacoes] = valor;
                        quantidadeMovimentacoes++;

                        cout << "\n[SUCESSO] Saque realizado com sucesso!\n";
                    }
                }
                break;
            }

            case 6: { 
                if (totalCadastradas < 2) {
                    cout << "\n[AVISO] E necessario ter pelo menos 2 contas cadastradas para transferir.\n";
                    break;
                }

                int numOrigem, numDestino;
                cout << "\nDigite o numero da conta de ORIGEM: ";
                cin >> numOrigem;
                cout << "Digite o numero da conta de DESTINO: ";
                cin >> numDestino;

                if (numOrigem == numDestino) {
                    cout << "\n[ERRO] A conta de origem e destino nao podem ser a mesma!\n";
                    break;
                }

                int idxOrigem = -1, idxDestino = -1;
                for (int i = 0; i < totalCadastradas; i++) {
                    if (numeroConta[i] == numOrigem) idxOrigem = i;
                    if (numeroConta[i] == numDestino) idxDestino = i;
                }

                if (idxOrigem == -1 || idxDestino == -1) {
                    cout << "\n[ERRO] Uma ou ambas as contas nao foram encontradas!\n";
                } else if (!contaAtiva[idxOrigem] || !contaAtiva[idxDestino]) {
                    cout << "\n[ERRO] Ambas as contas precisam estar ATIVAS para a transferencia!\n";
                } else {
                    double valor;
                    cout << "Valor da transferencia: R$ ";
                    cin >> valor;

                    if (valor <= 0) {
                        cout << "\n[ERRO] O valor da transferencia deve ser positivo!\n";
                    } else if (saldo[idxOrigem] < valor) {
                        cout << "\n[ERRO] Saldo insuficiente na conta de origem!\n";
                    } else if (quantidadeMovimentacoes + 2 > MAX_MOVIMENTACOES) {
                        cout << "\n[ERRO] Espaco insuficiente no historico de movimentacoes!\n";
                    } else {
                    
                        saldo[idxOrigem] = saldo[idxOrigem] - valor;
                        saldo[idxDestino] = saldo[idxDestino] + valor;

                        contaMovimentacao[quantidadeMovimentacoes] = numeroConta[idxOrigem];
                        tipoMovimentacao[quantidadeMovimentacoes] = 'S';
                        valorMovimentacao[quantidadeMovimentacoes] = valor;
                        quantidadeMovimentacoes++;

                        contaMovimentacao[quantidadeMovimentacoes] = numeroConta[idxDestino];
                        tipoMovimentacao[quantidadeMovimentacoes] = 'D';
                        valorMovimentacao[quantidadeMovimentacoes] = valor;
                        quantidadeMovimentacoes++;

                        cout << "\n[SUCESSO] Transferencia realizada com sucesso!\n";
                    }
                }
                break;
            }

            case 7: { 
                if (totalCadastradas == 0) {
                    cout << "\n[AVISO] Nenhuma conta cadastrada.\n";
                    break;
                }

                int numBusca;
                cout << "\nDigite o numero da conta para exibir o extrato: ";
                cin >> numBusca;

                int idx = -1;
                for (int i = 0; i < totalCadastradas; i++) {
                    if (numeroConta[i] == numBusca) {
                        idx = i;
                        break;
                    }
                }

                if (idx == -1) {
                    cout << "\n[ERRO] Conta nao encontrada!\n";
                } else {
                    cout << "\n====================================\n";
                    cout << "          EXTRATO DA CONTA: " << numBusca << "\n";
                    cout << "          TITULAR: " << nomeCliente[idx] << "\n";
                    cout << "====================================\n";
                    
                    bool temMovimento = false;
                    
                    for (int i = 0; i < quantidadeMovimentacoes; i++) {
                        if (contaMovimentacao[i] == numBusca) {
                            temMovimento = true;
                            if (tipoMovimentacao[i] == 'D') {
                                cout << "[-] Deposito: R$ " << valorMovimentacao[i] << "\n";
                            } else if (tipoMovimentacao[i] == 'S') {
                                cout << "[-] Saque: R$ " << valorMovimentacao[i] << "\n";
                            }
                        }
                    }

                    if (!temMovimento) {
                        cout << "Nenhuma movimentacao registrada para esta conta.\n";
                    }
                    cout << "------------------------------------\n";
                    cout << "Saldo Atual: R$ " << saldo[idx] << "\n";
                    cout << "====================================\n";
                }
                break;
            }

            case 8: { 
                if (totalCadastradas == 0) {
                    cout << "\n[AVISO] Nenhuma conta cadastrada.\n";
                    break;
                }

                int numBusca;
                cout << "\nDigite o numero da conta para alterar o tipo: ";
                cin >> numBusca;

                bool encontrada = false;
                for (int i = 0; i < totalCadastradas; i++) {
                    if (numeroConta[i] == numBusca) {
                        encontrada = true;
                        if (!contaAtiva[i]) {
                            cout << "\n[AVISO] A conta esta INATIVA. Operacao nao permitida!\n";
                        } else {
                            int novoTipo;
                            do {
                                cout << "Novo tipo (1 - Corrente | 2 - Poupanca): ";
                                cin >> novoTipo;
                                if (novoTipo != 1 && novoTipo != 2) cout << "[ERRO] Digite 1 ou 2!\n";
                            } while (novoTipo != 1 && novoTipo != 2);

                            tipoConta[i] = novoTipo;
                            cout << "\n[SUCESSO] Tipo de conta alterado para " 
                                 << (novoTipo == 1 ? "Corrente" : "Poupanca") << "!\n";
                        }
                        break;
                    }
                }
                if (!encontrada) {
                    cout << "\n[ERRO] Conta numero " << numBusca << " nao foi encontrada!\n";
                }
                break;
            }

            case 9: { 
                if (totalCadastradas == 0) {
                    cout << "\n[AVISO] Nenhuma conta cadastrada.\n";
                    break;
                }

                int numBusca;
                cout << "\nDigite o numero da conta: ";
                cin >> numBusca;

                bool encontrada = false;
                for (int i = 0; i < totalCadastradas; i++) {
                    if (numeroConta[i] == numBusca) {
                        encontrada = true;
                        contaAtiva[i] = !contaAtiva[i];
                        cout << "\n[SUCESSO] O status da conta " << numeroConta[i] 
                             << " mudou para: " << (contaAtiva[i] ? "ATIVA" : "INATIVA") << "\n";
                        break;
                    }
                }
                if (!encontrada) {
                    cout << "\n[ERRO] Conta numero " << numBusca << " nao foi encontrada!\n";
                }
                break;
            }

            case 10:
                cout << "\nSaindo do BANCO INF101... Ate logo!\n";
                break;

            default:
                cout << "\n[ERRO] Opcao invalida! Escolha um numero de 1 a 10.\n";
                break;
        }

    } while (opcao != 10);

    return 0;
}
